# /etc/hyrule-tunnel-proxy/env
# Public reverse-SSH tunnel daemon. Sibling to the network-proxy sidecar; runs as
# its own user with its own control-API token.

# Public SSH intake. ":2222" binds a dual-stack socket covering the IPv6 GUA and
# the DNAT'd IPv4. This is the ONLY intake that faces the Internet directly.
HTP_SSH_LISTEN_ADDR=:2222

# Internal control API — Hyrule Cloud (api VM) only. Never a wildcard bind.
HTP_CONTROL_LISTEN_ADDR=[2a0c:b641:b50:2::e0]:8452
# Metrics — mon only.
HTP_METRICS_LISTEN_ADDR=[2a0c:b641:b50:2::e0]:8453
# STUN binding responder (free), public UDP.
HTP_STUN_LISTEN_ADDR=:3478

# Bearer token for the control API (gates create/extend/revoke). >=32 chars.
HTP_AUTH_TOKEN=change-me

# Advertised public endpoint returned to the cloud / printed in banners.
HTP_ENDPOINT_HOST=tun.hyrule.host
HTP_SSH_PORT=2222

# Per-lease public data ports handed to visitors. One contiguous range so the rtr
# DNAT and host firewall are single rules.
HTP_DATA_PORT_RANGE=10000-10499

HTP_STATE_DIR=/var/lib/hyrule-tunnel-proxy
# HTP_HOST_KEY_PATH defaults to $HTP_STATE_DIR/ssh_host_ed25519_key

HTP_MIN_LEASE_SECONDS=3600
HTP_MAX_LEASE_SECONDS=2592000
HTP_MAX_VISITOR_CONNS_PER_LEASE=64

HTP_AUTH_ATTEMPTS_PER_WINDOW=5
HTP_AUTH_WINDOW_SECONDS=30
HTP_KEEPALIVE_SECONDS=30

HTP_LOG_LEVEL=info
